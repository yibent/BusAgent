{
  "schema_version": "1",
  "package": {
    "id": "robot-executor-agents",
    "version": "1.0.0"
  },
  "agents": [
    {
      "agent_id": "robot.execution_coordinator",
      "endpoint": {
        "adapter": "in-process",
        "registration_key": "ExecutionCoordinatorNode"
      },
      "consumes": ["execution.profile.selected", "interrupt.requested"],
      "produces": ["robot.execute.requested"],
      "configuration_schema": "schemas/coordinator-config.json",
      "concurrency": {
        "mode": "partitioned",
        "partition_key": "task_id",
        "limit": 8
      },
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 0,
        "dead_letter": true
      },
      "permissions": {
        "context": ["task.*"],
        "side_effects": ["robot.execute.requested"]
      }
    },
    {
      "agent_id": "robot.device_adapter",
      "endpoint": {
        "adapter": "in-process",
        "registration_key": "RobotAdapterNode"
      },
      "consumes": ["robot.execute.requested"],
      "produces": [
        "execution.queued",
        "execution.cancelled",
        "execution.accepted",
        "execution.started",
        "execution.progress",
        "execution.completed",
        "execution.failed",
        "execution.unknown",
        "perception.observed"
      ],
      "configuration_schema": "schemas/executor-config.json",
      "concurrency": {
        "mode": "serial",
        "limit": 1
      },
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 0,
        "dead_letter": true
      },
      "permissions": {
        "context": ["task.*"],
        "side_effects": []
      }
    },
    {
      "agent_id": "robot.vision",
      "endpoint": {
        "adapter": "in-process",
        "registration_key": "VisionNode"
      },
      "consumes": ["perception.observed"],
      "produces": ["perception.reported"],
      "configuration_schema": "schemas/executor-config.json",
      "concurrency": {
        "mode": "serial",
        "limit": 1
      },
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 0,
        "dead_letter": true
      },
      "permissions": {
        "context": [],
        "side_effects": []
      }
    }
  ]
}
