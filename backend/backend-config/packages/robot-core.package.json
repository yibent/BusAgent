{
  "schema_version": "1",
  "package": {
    "id": "robot-core-agents",
    "version": "1.0.0"
  },
  "agents": [
    {
      "agent_id": "robot.instruction_understanding",
      "endpoint": {
        "adapter": "in-process",
        "registration_key": "InstructionUnderstandingNode"
      },
      "consumes": ["intent.created"],
      "produces": [
        "instruction.parsed",
        "interaction.classified",
        "conversation.requested"
      ],
      "configuration_schema": "schemas/instruction-config.json",
      "concurrency": {
        "mode": "partitioned",
        "partition_key": "conversation_id",
        "limit": 16
      },
      "retry": {
        "max_attempts": 2,
        "backoff_ms": 200,
        "dead_letter": true
      },
      "permissions": {
        "context": ["conversation.*", "task.*"],
        "side_effects": []
      }
    },
    {
      "agent_id": "robot.grounding_clarification",
      "endpoint": {
        "adapter": "in-process",
        "registration_key": "GroundingClarificationNode"
      },
      "consumes": ["instruction.parsed", "scene.snapshot.updated"],
      "produces": ["command.grounded", "observation.ready", "clarification.requested"],
      "configuration_schema": "schemas/grounding-config.json",
      "concurrency": {
        "mode": "partitioned",
        "partition_key": "task_id",
        "limit": 8
      },
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 0,
        "dead_letter": true
      },
      "permissions": {
        "context": ["task.*", "conversation.*", "scene.*"],
        "side_effects": []
      }
    },
    {
      "agent_id": "robot.task_planner",
      "endpoint": {
        "adapter": "in-process",
        "registration_key": "TaskPlannerNode"
      },
      "consumes": ["command.grounded", "perception.completed"],
      "produces": ["plan.proposed", "plan.failed"],
      "configuration_schema": "schemas/planner-config.json",
      "concurrency": {
        "mode": "partitioned",
        "partition_key": "task_id",
        "limit": 8
      },
      "retry": {
        "max_attempts": 3,
        "backoff_ms": 1000,
        "dead_letter": true
      },
      "permissions": {
        "context": ["task.*", "perception.*"],
        "side_effects": []
      }
    },
    {
      "agent_id": "robot.loop_router",
      "endpoint": {
        "adapter": "in-process",
        "registration_key": "LoopRouterNode"
      },
      "consumes": ["plan.validated"],
      "produces": ["execution.profile.selected"],
      "configuration_schema": "schemas/loop-router-config.json",
      "concurrency": {
        "mode": "partitioned",
        "partition_key": "task_id",
        "limit": 8
      },
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 0,
        "dead_letter": true
      },
      "permissions": {
        "context": ["task.*", "scene.*"],
        "side_effects": []
      }
    },
    {
      "agent_id": "robot.plan_validator",
      "endpoint": {
        "adapter": "in-process",
        "registration_key": "PlanValidatorNode"
      },
      "consumes": ["plan.proposed"],
      "produces": ["plan.validated", "plan.rejected"],
      "configuration_schema": "schemas/plan-validator-config.json",
      "concurrency": {
        "mode": "partitioned",
        "partition_key": "task_id",
        "limit": 8
      },
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 0,
        "dead_letter": true
      },
      "permissions": {
        "context": ["task.*"],
        "side_effects": []
      }
    },
    {
      "agent_id": "robot.interrupt_monitor",
      "endpoint": {
        "adapter": "in-process",
        "registration_key": "InterruptMonitorNode"
      },
      "consumes": ["transcript.delta", "transcript.final"],
      "produces": ["interrupt.requested"],
      "configuration_schema": "schemas/interrupt-monitor-config.json",
      "concurrency": {
        "mode": "partitioned",
        "partition_key": "conversation_id",
        "limit": 16
      },
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 0,
        "dead_letter": true
      },
      "permissions": {
        "context": ["conversation.*", "task.*"],
        "side_effects": []
      }
    },
    {
      "agent_id": "robot.dialogue",
      "endpoint": {
        "adapter": "in-process",
        "registration_key": "DialogueAgent"
      },
      "consumes": [
        "intent.created",
        "interaction.classified",
        "instruction.parsed",
        "command.grounded",
        "execution.accepted",
        "execution.queued",
        "execution.cancelled",
        "plan.failed",
        "conversation.requested",
        "observation.ready",
        "execution.completed",
        "execution.failed",
        "execution.unknown",
        "clarification.requested",
        "plan.rejected",
        "transcript.delta",
        "transcript.final",
        "execution.started",
        "execution.progress",
        "intelligence.reply"
      ],
      "produces": ["reply.created"],
      "configuration_schema": "schemas/dialogue-config.json",
      "concurrency": {
        "mode": "partitioned",
        "partition_key": "conversation_id",
        "limit": 16
      },
      "retry": {
        "max_attempts": 2,
        "backoff_ms": 500,
        "dead_letter": true
      },
      "permissions": {
        "context": ["conversation.*"],
        "side_effects": []
      }
    },
    {
      "agent_id": "robot.stt",
      "endpoint": {
        "adapter": "in-process",
        "registration_key": "SttAgent"
      },
      "consumes": [],
      "produces": ["transcript.delta", "transcript.final", "intent.created"],
      "configuration_schema": "schemas/stt-config.json",
      "concurrency": {
        "mode": "partitioned",
        "partition_key": "stream_id",
        "limit": 8
      },
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 0,
        "dead_letter": true
      },
      "permissions": {
        "context": ["conversation.*"],
        "side_effects": []
      }
    },
    {
      "agent_id": "robot.tts",
      "endpoint": {
        "adapter": "in-process",
        "registration_key": "TtsAgent"
      },
      "consumes": [],
      "produces": [],
      "configuration_schema": "schemas/tts-config.json",
      "concurrency": {
        "mode": "partitioned",
        "partition_key": "conversation_id",
        "limit": 8
      },
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 0,
        "dead_letter": true
      },
      "permissions": {
        "context": ["conversation.*"],
        "side_effects": []
      }
    },
    {
      "agent_id": "robot.intelligence",
      "endpoint": {
        "adapter": "in-process",
        "registration_key": "IntelligenceNode"
      },
      "consumes": [
        "intent.created",
        "interrupt.requested",
        "execution.accepted",
        "execution.started",
        "execution.progress",
        "execution.completed",
        "execution.failed",
        "execution.unknown",
        "execution.cancelled",
        "plan.rejected",
        "perception.reported",
        "intelligence.decision.proposed"
      ],
      "produces": [
        "plan.proposed",
        "intelligence.reply",
        "intelligence.observed",
        "interrupt.requested",
        "task.cancelled",
        "planning.requested",
        "supervision.requested"
      ],
      "configuration_schema": "schemas/intelligence-config.json",
      "concurrency": {
        "mode": "serial",
        "limit": 1
      },
      "retry": {
        "max_attempts": 2,
        "backoff_ms": 500,
        "dead_letter": true
      },
      "permissions": {
        "context": ["task.*", "conversation.*", "perception.*"],
        "side_effects": []
      }
    },
    {
      "agent_id": "robot.planning",
      "endpoint": {
        "adapter": "in-process",
        "registration_key": "PlanningAgentNode"
      },
      "consumes": ["planning.requested"],
      "produces": ["intelligence.decision.proposed"],
      "configuration_schema": "schemas/intelligence-config.json",
      "concurrency": {
        "mode": "partitioned",
        "partition_key": "goal_id",
        "limit": 2
      },
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 0,
        "dead_letter": true
      },
      "permissions": {
        "context": ["task.*", "conversation.*", "perception.*"],
        "side_effects": []
      }
    },
    {
      "agent_id": "robot.supervision",
      "endpoint": {
        "adapter": "in-process",
        "registration_key": "SupervisionAgentNode"
      },
      "consumes": ["supervision.requested"],
      "produces": ["intelligence.decision.proposed"],
      "configuration_schema": "schemas/intelligence-config.json",
      "concurrency": {
        "mode": "partitioned",
        "partition_key": "goal_id",
        "limit": 2
      },
      "retry": {
        "max_attempts": 1,
        "backoff_ms": 0,
        "dead_letter": true
      },
      "permissions": {
        "context": ["task.*", "conversation.*", "perception.*"],
        "side_effects": []
      }
    }
  ]
}
