{
  "schema_version": "1",
  "app": {
    "id": "desktop-robot-assistant",
    "version": "2026.08"
  },
  "agents": [
    {
      "agent_id": "robot.stt",
      "required": true,
      "config": {
        "language": "zh",
        "sample_rate": 16000,
        "encoding": "pcm",
        "interim_results": true,
        "emit_uncommitted": true,
        "endpointing_ms": 400,
        "utterance_settle_ms": 900,
        "barge_in_min_chars": 3,
        "model": "qwen3-asr-flash-realtime"
      }
    },
    {
      "agent_id": "robot.planner",
      "required": false,
      "config": {
        "prompt_file": "prompts/planner.md",
        "model": "configured-by-agent",
        "max_plan_depth": 8
      },
      "retry_override": { "max_attempts": 2 }
    },
    {
      "agent_id": "robot.dialogue",
      "required": true,
      "config": {
        "prompt_file": "prompts/dialogue.md",
        "language": "zh-CN",
        "model": "qwen-plus"
      }
    },
    {
      "agent_id": "robot.tts",
      "required": true,
      "config": {
        "model": "qwen3-tts-flash-realtime",
        "voice": "Cherry",
        "sample_rate": 24000,
        "language_type": "Chinese"
      }
    },
    {
      "agent_id": "robot.executor",
      "required": true,
      "config": {}
    }
  ],
  "routes": [
    {
      "event": "transcript.delta",
      "from": ["robot.stt"],
      "to": ["robot.dialogue"]
    },
    {
      "event": "transcript.final",
      "from": ["robot.stt"],
      "to": ["robot.dialogue"]
    },
    {
      "event": "intent.created",
      "to": ["robot.planner", "robot.dialogue"]
    },
    {
      "event": "plan.created",
      "from": ["robot.planner"],
      "to": ["robot.executor"]
    }
  ]
}
