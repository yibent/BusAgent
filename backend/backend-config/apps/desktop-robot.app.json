{
  "schema_version": "1",
  "app": {
    "id": "desktop-robot-assistant",
    "version": "2026.08"
  },
  "agents": [
    {
      "agent_id": "robot.stt",
      "required": true,
      "config": {
        "language": "zh",
        "sample_rate": 16000,
        "encoding": "pcm",
        "interim_results": true,
        "emit_uncommitted": true,
        "endpointing_ms": 400,
        "utterance_settle_ms": 900,
        "barge_in_min_chars": 3,
        "model": "qwen3-asr-flash-realtime"
      }
    },
    {
      "agent_id": "robot.interrupt_monitor",
      "required": true,
      "config": {
        "scope": "arm-01"
      }
    },
    {
      "agent_id": "robot.instruction_understanding",
      "required": true,
      "config": {
        "parser": "model",
        "parallel_interaction": true,
        "model": "qwen3.8-flash",
        "reasoning": "low"
      }
    },
    {
      "agent_id": "robot.grounding_clarification",
      "required": true,
      "config": {
        "provider": "rgbd",
        "controller_url": "http://127.0.0.1:7861"
      }
    },
    {
      "agent_id": "robot.task_planner",
      "required": true,
      "config": {
        "prompt_file": "prompts/planner.md",
        "model": "configured-by-agent",
        "max_plan_depth": 8
      },
      "retry_override": {
        "max_attempts": 2
      }
    },
    {
      "agent_id": "robot.plan_validator",
      "required": true,
      "config": {}
    },
    {
      "agent_id": "robot.loop_router",
      "required": true,
      "config": {
        "strategy": "l0_rules",
        "profiles": {
          "perceive": {
            "primary": "approach_fast_loop",
            "fallbacks": [
              "precise_perception_loop"
            ]
          },
          "select_target": {
            "primary": "approach_fast_loop",
            "fallbacks": [
              "open_world_recognition_loop"
            ]
          },
          "plan_grasp": {
            "primary": "fine_grasp_geometry_loop",
            "fallbacks": [
              "fine_grasp_visual_servo",
              "fine_grasp_act",
              "fine_grasp_vla"
            ]
          },
          "move_to": {
            "primary": "approach_fast_loop",
            "fallbacks": []
          },
          "grasp": {
            "primary": "fine_grasp_geometry_loop",
            "fallbacks": [
              "fine_grasp_visual_servo",
              "fine_grasp_act",
              "fine_grasp_vla"
            ]
          },
          "transport": {
            "primary": "transport_loop",
            "fallbacks": []
          },
          "place": {
            "primary": "fine_place_loop",
            "fallbacks": [
              "fine_place_visual_servo"
            ]
          },
          "verify_placement": {
            "primary": "verification_loop",
            "fallbacks": [
              "precise_perception_loop"
            ]
          },
          "follow": {
            "primary": "approach_fast_loop",
            "fallbacks": []
          },
          "hold": {
            "primary": "interrupt_safe_transition_loop",
            "fallbacks": []
          },
          "stop": {
            "primary": "interrupt_safe_transition_loop",
            "fallbacks": []
          },
          "status": {
            "primary": "interaction_loop",
            "fallbacks": []
          }
        }
      }
    },
    {
      "agent_id": "robot.dialogue",
      "required": true,
      "config": {
        "prompt_file": "prompts/dialogue.md",
        "language": "zh-CN",
        "model": "qwen-flash",
        "parallel_interaction": true,
        "controller_url": "http://127.0.0.1:7861",
        "reasoning": "none"
      }
    },
    {
      "agent_id": "robot.tts",
      "required": true,
      "config": {
        "model": "qwen3-tts-flash-realtime",
        "voice": "Cherry",
        "speech_rate": 1.15,
        "sample_rate": 24000,
        "language_type": "Chinese"
      }
    },
    {
      "agent_id": "robot.execution_coordinator",
      "required": true,
      "config": {}
    },
    {
      "agent_id": "robot.device_adapter",
      "required": true,
      "config": {
        "controller_url": "http://127.0.0.1:7861",
        "request_timeout_ms": 10000
      }
    }
  ],
  "routes": [
    { "event": "execution.queued", "from": ["robot.device_adapter"], "to": ["robot.dialogue"] },
    { "event": "execution.cancelled", "from": ["robot.device_adapter"], "to": ["robot.dialogue"] },
    { "event": "observation.ready", "from": ["robot.grounding_clarification"], "to": ["robot.dialogue"] },
    { "event": "interaction.classified", "from": ["robot.instruction_understanding"], "to": ["robot.dialogue"] },
    { "event": "execution.accepted", "from": ["robot.device_adapter"], "to": ["robot.dialogue"] },
    { "event": "plan.failed", "from": ["robot.task_planner"], "to": ["robot.dialogue"] },
    {
      "event": "transcript.delta",
      "from": [
        "robot.stt"
      ],
      "to": [
        "robot.dialogue",
        "robot.interrupt_monitor"
      ]
    },
    {
      "event": "transcript.final",
      "from": [
        "robot.stt"
      ],
      "to": [
        "robot.dialogue",
        "robot.interrupt_monitor"
      ]
    },
    {
      "event": "intent.created",
      "to": [
        "robot.instruction_understanding",
        "robot.dialogue"
      ]
    },
    {
      "event": "instruction.parsed",
      "from": [
        "robot.instruction_understanding"
      ],
      "to": [
        "robot.grounding_clarification",
        "robot.dialogue"
      ]
    },
    {
      "event": "command.grounded",
      "from": [
        "robot.grounding_clarification"
      ],
      "to": [
        "robot.task_planner",
        "robot.dialogue"
      ]
    },
    {
      "event": "clarification.requested",
      "from": [
        "robot.grounding_clarification"
      ],
      "to": [
        "robot.dialogue"
      ]
    },
    {
      "event": "plan.proposed",
      "from": [
        "robot.task_planner"
      ],
      "to": [
        "robot.plan_validator"
      ]
    },
    {
      "event": "plan.validated",
      "from": [
        "robot.plan_validator"
      ],
      "to": [
        "robot.loop_router"
      ]
    },
    {
      "event": "execution.profile.selected",
      "from": [
        "robot.loop_router"
      ],
      "to": [
        "robot.execution_coordinator"
      ]
    },
    {
      "event": "plan.rejected",
      "from": [
        "robot.plan_validator"
      ],
      "to": [
        "robot.dialogue"
      ]
    },
    {
      "event": "interrupt.requested",
      "from": [
        "robot.interrupt_monitor"
      ],
      "to": [
        "robot.execution_coordinator"
      ]
    },
    {
      "event": "robot.execute.requested",
      "from": [
        "robot.execution_coordinator"
      ],
      "to": [
        "robot.device_adapter"
      ]
    },
    {
      "event": "execution.completed",
      "from": [
        "robot.device_adapter"
      ],
      "to": [
        "robot.dialogue"
      ]
    },
    {
      "event": "execution.failed",
      "from": [
        "robot.device_adapter"
      ],
      "to": [
        "robot.dialogue"
      ]
    },
    {
      "event": "execution.unknown",
      "from": [
        "robot.device_adapter"
      ],
      "to": [
        "robot.dialogue"
      ]
    },
    {
      "event": "conversation.requested",
      "from": [
        "robot.instruction_understanding"
      ],
      "to": [
        "robot.dialogue"
      ]
    },
    {
      "event": "execution.progress",
      "from": ["robot.device_adapter"],
      "to": ["robot.dialogue"]
    },
    {
      "event": "execution.started",
      "from": [
        "robot.device_adapter"
      ],
      "to": [
        "robot.dialogue"
      ]
    }
  ]
}
